{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta6-explorer.invalid/schemas/completion.schema.json",
  "title": "Task completion reported to the MCP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commit_sha",
    "summary_md",
    "deliverables",
    "validation",
    "ai_assisted",
    "game_data_in_deliverables"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{16}$"
    },
    "pr_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "maxLength": 200
    },
    "summary_md": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "knowledge_md",
        "tests",
        "artifacts"
      ],
      "properties": {
        "code": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "knowledge_md": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "tests": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "environment"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "exit_code"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "exit_code": {
                "type": "integer"
              },
              "summary": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os"
          ],
          "properties": {
            "os": {
              "type": "string",
              "maxLength": 100
            },
            "gpu": {
              "type": "string",
              "maxLength": 100
            },
            "driver": {
              "type": "string",
              "maxLength": 100
            },
            "toolchain": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "planning_proposal_id": {
      "type": "string",
      "maxLength": 80
    },
    "ai_assisted": {
      "type": "boolean"
    },
    "game_data_in_deliverables": {
      "const": false
    },
    "notes_md": {
      "type": "string",
      "maxLength": 10000
    }
  }
}
