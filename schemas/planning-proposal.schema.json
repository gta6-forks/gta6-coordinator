{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta6-explorer.invalid/schemas/planning-proposal.schema.json",
  "title": "Planning proposal (submitted as JSON in a PR to the coordinator repository)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "rationale_md",
    "based_on",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "rationale_md": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "based_on": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap_version",
        "snapshot_at"
      ],
      "properties": {
        "roadmap_version": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_at": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "x-discriminator": "op",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "ref",
              "repo",
              "title",
              "body_md",
              "task"
            ],
            "properties": {
              "op": {
                "const": "create_issue"
              },
              "ref": {
                "type": "string",
                "pattern": "^new:[a-z0-9-]+$"
              },
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "replaces_draft": {
                "type": "string",
                "pattern": "^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "body_md": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "task": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "reason"
            ],
            "properties": {
              "op": {
                "const": "close_issue"
              },
              "id": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "priority"
            ],
            "properties": {
              "op": {
                "const": "set_priority"
              },
              "id": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              },
              "priority": {
                "enum": [
                  "p0",
                  "p1",
                  "p2",
                  "p3"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "readiness"
            ],
            "properties": {
              "op": {
                "const": "set_readiness"
              },
              "id": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              },
              "readiness": {
                "enum": [
                  "draft",
                  "ready",
                  "needs_info",
                  "blocked_external"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "depends_on"
            ],
            "properties": {
              "op": {
                "const": "add_dependency"
              },
              "id": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              },
              "depends_on": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "depends_on"
            ],
            "properties": {
              "op": {
                "const": "remove_dependency"
              },
              "id": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              },
              "depends_on": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "parent",
              "child"
            ],
            "properties": {
              "op": {
                "const": "add_subissue"
              },
              "parent": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              },
              "child": {
                "type": "string",
                "pattern": "(^(([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)|(local:[a-z0-9][a-z0-9/_.-]*)|(draft:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[a-z0-9-]+))$)|(^new:[a-z0-9-]+$)"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "milestone",
              "change_md"
            ],
            "properties": {
              "op": {
                "const": "roadmap_change"
              },
              "milestone": {
                "type": "string",
                "maxLength": 80
              },
              "change_md": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "text_md"
            ],
            "properties": {
              "op": {
                "const": "set_objective"
              },
              "text_md": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              }
            }
          }
        ]
      }
    }
  }
}
